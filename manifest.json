{
  "manifest_version": 3,
  "name": "Session Keeper — QuickBooks & Xero",
  "version": "2.6.0",
  "description": "Keeps QuickBooks Online and Xero from signing you out for inactivity, using randomised timing and without ever clicking, typing or reloading your page.",
  "permissions": ["alarms", "storage", "scripting"],
  "host_permissions": [
    "https://*.intuit.com/*",
    "https://*.xero.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.intuit.com/*",
        "https://*.xero.com/*"
      ],
      "js": ["sites.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Session Keeper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
